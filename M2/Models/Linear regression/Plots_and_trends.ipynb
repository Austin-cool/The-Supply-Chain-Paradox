    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "\n",
    "for store in store_ids: \n",
    "    fig, axes = plt.subplots(9, 1, figsize=(10, 40), sharex=True)\n",
    "    \n",
    "    for ax, department in zip(axes.flat, Departments):\n",
    "        dataset = Data_per_store[store][department]\n",
    "        a = [i for i in dataset.columns.tolist() if \"profit\" in i]\n",
    "        b = [i for i in dataset.columns.tolist() if \"zero\" in i]\n",
    "    \n",
    "        x = dataset[b[0]].to_numpy()\n",
    "        y = dataset[a[0]].to_numpy()\n",
    "    \n",
    "        # Drop NaNs so the regression doesn't choke\n",
    "        mask = ~(np.isnan(x) | np.isnan(y))\n",
    "        x, y = x[mask], y[mask]\n",
    "    \n",
    "        # Scatter\n",
    "        ax.scatter(x, y, s=20, alpha=0.6, edgecolor='k', linewidth=0.3, label='data')\n",
    "    \n",
    "        # Linear regression\n",
    "        if len(x) > 1:\n",
    "            slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)\n",
    "            x_line = np.linspace(0, 1, 100)\n",
    "            y_line = slope * x_line + intercept\n",
    "            ax.plot(x_line, y_line, 'r-', linewidth=2,\n",
    "                    label=f'y = {slope:.2f}x + {intercept:.2f}  (R² = {r_value**2:.3f})')\n",
    "            ax.legend(loc='best', fontsize=8)\n",
    "    \n",
    "        ax.set_xlim(-0.05, 1)\n",
    "        ax.set_title(f'Profit in {department} Department')\n",
    "        ax.set_ylabel('Profit')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "    \n",
    "    fig.tight_layout()\n",
    "    \n",
    "    # --- Save as SVG ---\n",
    "    fig.savefig(\n",
    "        f\"Profit vs zero rate per department in {store}.svg\",\n",
    "        bbox_inches='tight'\n",
    "    )\n",
    "    \n",
    "    plt.close(fig)"
   ]
  },
