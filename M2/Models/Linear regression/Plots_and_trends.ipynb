    "All_stores = pd.read_csv('../merged_all_stores.csv')\n",
    "store_ids = [104, 117, 123, 131, 208, 214, 226, 305, 311, 318]\n",
    "Departments = ['Health', 'Meat', 'Household', 'Beverages', 'Grocery', 'Frozen', 'Bakery', 'Produce','Dairy']\n",
    "\n",
    "Data_per_store = {}\n",
    "for store in store_ids:\n",
    "    Data_per_store[store] = {}\n",
    "\n",
    "    Table = All_stores.loc[\n",
    "            (All_stores[\"store_id\"] == store)\n",
    "        ]\n",
    "    \n",
    "    for department in Departments:\n",
    "        a = [i for i in Table.columns.tolist() if department in i]\n",
    "        b = ['date', 'sale_week_type']\n",
    "        subset = Table[b + a]\n",
    "\n",
    "        Data_per_store[store][department] = subset"
   ]
